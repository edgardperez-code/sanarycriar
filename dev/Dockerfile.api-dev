# Imagen de DESARROLLO para la API de LearnHouse (con dependencias de test).
# El código se monta como volumen en /app; el venv vive en /opt/venv para no ocultarlo.
FROM python:3.14.7-alpine3.24
RUN apk upgrade --no-cache && apk add --no-cache curl netcat-openbsd ffmpeg bash libstdc++
COPY --from=ghcr.io/astral-sh/uv:0.10.7 /uv /uvx /bin/
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_LINK_MODE=copy PATH=/opt/venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --no-cache
