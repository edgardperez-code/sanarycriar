---
import { render } from 'astro:content';
import { ArrowLeft } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FinalCta from '@/components/FinalCta.astro';
import { formatDate, getPublishedPosts, type BlogPost } from '@/lib/content';
import { absoluteUrl, site } from '@/site.config';
import { breadcrumbJsonLd } from '@/lib/seo';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { Content } = await render(post);
const url = absoluteUrl(`/blog/${post.id}`);

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  inLanguage: 'es',
  mainEntityOfPage: url,
  url,
  image: post.data.cover ? absoluteUrl(post.data.cover) : absoluteUrl('/og-image.png'),
  author: { '@type': 'Person', '@id': `${site.url}/#hilda`, name: site.professional.name },
  publisher: { '@id': `${site.url}/#consulta` },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  image={post.data.cover}
  jsonLd={[
    articleJsonLd,
    breadcrumbJsonLd([
      { name: 'Inicio', path: '/' },
      { name: 'Blog', path: '/blog' },
      { name: post.data.title, path: `/blog/${post.id}` },
    ]),
  ]}
>
  <article class="mx-auto max-w-6xl px-4 pb-16 pt-10 sm:px-6 sm:pb-24 sm:pt-16">
    <a href="/blog" class="text-link inline-flex items-center gap-1.5 text-[0.9375rem]">
      <ArrowLeft size={16} strokeWidth={2} aria-hidden="true" />
      Volver al blog
    </a>
    <header class="mt-8 max-w-3xl">
      <time class="eyebrow" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <h1 class="h1 mt-4">{post.data.title}</h1>
      <p class="lead mt-5">{post.data.description}</p>
      <p class="note mt-4">Por {site.professional.name}, {site.professional.title.toLowerCase()}</p>
    </header>
    {
      post.data.cover && (
        <img
          src={post.data.cover}
          alt={post.data.coverAlt ?? ''}
          class="mt-10 aspect-[16/9] w-full max-w-4xl rounded-[var(--radius-card)] object-cover"
          width="1200"
          height="675"
        />
      )
    }
    <div class="prose-brand mt-10 text-[1.0625rem] leading-relaxed sm:text-lg">
      <Content />
    </div>
  </article>
  <FinalCta />
</BaseLayout>
