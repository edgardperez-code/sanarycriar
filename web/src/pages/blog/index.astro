---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import PostCards from '@/components/PostCards.astro';
import EmptyState from '@/components/EmptyState.astro';
import { getPublishedPosts } from '@/lib/content';

// Markdown articles in src/content/blog. While there are none, the page is a
// friendly "coming soon" (noindex) and the menu link stays hidden.
const posts = await getPublishedPosts();
const empty = posts.length === 0;
---

<BaseLayout
  title="Blog"
  description="Artículos de Hilda Hernández, psicóloga infanto-juvenil, sobre crianza consciente, emociones y maternidad."
  noindex={empty}
>
  <section class="watercolor" aria-labelledby="page-title">
    <div class="mx-auto max-w-6xl px-4 pb-16 pt-12 sm:px-6 sm:pb-24 sm:pt-20">
      <SectionHeading
        level="h1"
        id="page-title"
        eyebrow="Artículos"
        title="Blog de crianza"
        accent="crianza"
        intro={empty ? undefined : 'Lecturas cortas para entender lo que pasa en casa y acompañar desde la calma.'}
      />
      <div class="mt-12">
        {
          empty ? (
            <EmptyState
              title="Estamos escribiendo los primeros artículos."
              text="Muy pronto encontrarás aquí lecturas cortas sobre crianza, emociones y maternidad."
            />
          ) : (
            <PostCards posts={posts} headingLevel="h2" />
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
