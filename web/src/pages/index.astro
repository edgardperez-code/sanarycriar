---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import Enfoque from '@/components/home/Enfoque.astro';
import QuizSection from '@/components/QuizSection.astro';
import FreeEbook from '@/components/home/FreeEbook.astro';
import PaidEbook from '@/components/home/PaidEbook.astro';
import Cartas from '@/components/home/Cartas.astro';
import CitaCta from '@/components/home/CitaCta.astro';
import TestimonialCards from '@/components/TestimonialCards.astro';
import { getTestimonials } from '@/lib/content';
import { businessJsonLd, websiteJsonLd } from '@/lib/seo';

// Client guide (2026-11): the Home page is one path. Meet Hilda → take the test
// → read the free ebook → buy «Límites sin culpa» → read her letters → book a
// session at the end. Talleres, blog and FAQ stay on their own pages.
const testimonials = getTestimonials().slice(0, 3);
---

<BaseLayout
  description="Antes de corregir a tu hijo, descubre qué se activa en ti. Hilda Hernández, psicóloga infanto-juvenil (FPV 8.914): test de crianza, ebooks y citas online para criar sin culpa."
  jsonLd={[businessJsonLd(), websiteJsonLd()]}
  footerNewsletter={false}
>
  <Hero />
  <Enfoque />
  <QuizSection />
  <FreeEbook />
  <PaidEbook />

  {
    testimonials.length > 0 && (
      <section id="testimonios" class="bg-nube" aria-labelledby="testimonios-title">
        <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
          <div class="mx-auto max-w-3xl text-center">
            <p class="eyebrow">Voces</p>
            <h2 id="testimonios-title" class="h2 mt-4">
              Lo que dicen las <em class="title-accent">mamás</em>
            </h2>
          </div>
          <div class="mt-12">
            <TestimonialCards items={testimonials} />
          </div>
        </div>
      </section>
    )
  }

  <Cartas />
  <CitaCta />
</BaseLayout>
