---
import ParentingQuiz from '@/components/islands/ParentingQuiz';
import { quizInstructions, quizIntro } from '@/lib/quiz';

interface Props {
  level?: 'h1' | 'h2';
  /** Hydrate immediately (dedicated page) or when visible (Home). */
  eager?: boolean;
}

const { level = 'h2', eager = false } = Astro.props;
const Heading = level;
// The quiz question/final card heading sits one level below the section title.
const itemLevel = level === 'h1' ? 'h2' : 'h3';
---

<section id="test" class="bg-lavanda-100" aria-labelledby="quiz-title">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">Test de crianza · 2 minutos</p>
      <Heading id="quiz-title" class:list={['mt-4', level === 'h1' ? 'h1' : 'h2']}>
        ¿Desde dónde estás <em class="title-accent">criando</em>?
      </Heading>
      <p class="lead mx-auto mt-4">{quizIntro} {quizInstructions}</p>
    </div>
    <div class="mx-auto mt-10 max-w-3xl">
      {eager ? <ParentingQuiz client:load headingLevel={itemLevel} /> : <ParentingQuiz client:visible headingLevel={itemLevel} />}
    </div>
  </div>
</section>
