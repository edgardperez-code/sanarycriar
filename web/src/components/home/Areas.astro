---
import { ArrowRight } from 'lucide-react';
import AreaIcon from '@/components/AreaIcon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { mainAreas, otherAreas } from '@/data/areas';
---

<section id="areas" class="watercolor-tl watercolor" aria-labelledby="areas-title">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <SectionHeading
      id="areas-title"
      eyebrow="Áreas de trabajo"
      title="¿En qué te acompaño?"
      accent="acompaño"
      intro="Un espacio cercano para acompañarte en la crianza durante los primeros años y en tu camino como mamá."
    />

    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {
        mainAreas.map((area) => (
          <article class="card p-7 sm:p-8">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-lavanda-100 text-lavanda-600">
              <AreaIcon name={area.icon} />
            </span>
            <h3 class="h3 mt-5 text-[1.375rem]">{area.title}</h3>
            <p class="mt-3 max-w-[60ch] text-violeta-600">{area.description}</p>
          </article>
        ))
      }
    </div>

    <h3 class="mt-14 font-sans text-base font-semibold text-violeta">También acompaño</h3>
    <ul class="mt-5 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        otherAreas.map((area) => (
          <li class="flex items-start gap-4">
            <span class="mt-0.5 shrink-0 text-lavanda-600">
              <AreaIcon name={area.icon} size={22} />
            </span>
            <span>
              <span class="block font-semibold leading-snug text-violeta">{area.title}</span>
              <span class="mt-1 block text-[0.9375rem] leading-relaxed text-violeta-500">{area.description}</span>
            </span>
          </li>
        ))
      }
    </ul>

    <div class="mt-12 flex flex-col gap-3 sm:flex-row sm:items-center">
      <a href="/agenda" class="btn btn-primary">
        Agenda tu consulta
        <ArrowRight size={18} strokeWidth={2} aria-hidden="true" />
      </a>
      <p class="note sm:ml-3">Sesiones individuales por videollamada.</p>
    </div>
  </div>
</section>
