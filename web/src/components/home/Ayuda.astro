---
import { ArrowRight } from 'lucide-react';
import AreaIcon from '@/components/AreaIcon.astro';
import FaqList from '@/components/FaqList.astro';
import { mainAreas, otherAreas } from '@/data/areas';
import { homeFaqs } from '@/data/faqs';

// SEO/GEO (2026-11): the topics mothers search for (rabietas, límites,
// ansiedad, TDAH, autismo, adolescencia) in plain words, with Hilda's areas
// from the brief, plus three direct answers search engines and AI assistants
// can quote. Sits right before the booking block.
// Desktop rows of a six-column grid: the two main areas (3 + 3), then three
// areas (2 + 2 + 2), then the last two (3 + 3), so every row is full. On
// tablets (two columns) the last card spans the row instead of sitting alone.
const areas = [...mainAreas, ...otherAreas];
const total = areas.length;
const wide = (index: number) => index < mainAreas.length || index >= total - 2;

const links = [
  { href: '/sobre-mi', label: 'Conoce mi historia y mi formación' },
  { href: '/sesiones-online', label: 'Sesiones online: precios y cómo agendar' },
  { href: '/talleres', label: 'Talleres para colegios y empresas' },
  { href: '/preguntas-frecuentes', label: 'Todas las preguntas frecuentes' },
];
---

<section id="ayuda" class="bg-blanco-calido" aria-labelledby="ayuda-title">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="max-w-3xl">
      <p class="eyebrow">Cómo te acompaño</p>
      <h2 id="ayuda-title" class="h2 mt-4">¿En qué te puedo <em class="title-accent">ayudar</em>?</h2>
      <p class="lead mt-5">
        Acompaño a mamás y familias de Venezuela y de otros países, por videollamada, en estos temas de la infancia, la maternidad y la
        adolescencia.
      </p>
    </div>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
      {
        areas.map((area, index) => (
          <li class:list={['card flex gap-4 p-5', total % 2 === 1 && 'sm:max-lg:last:col-span-2', wide(index) ? 'lg:col-span-3' : 'lg:col-span-2']}>
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-lavanda-100 text-lavanda-700">
              <AreaIcon name={area.icon} size={22} />
            </span>
            <div class="min-w-0">
              <h3 class="font-serif text-[1.125rem] font-semibold leading-snug text-violeta">{area.title}</h3>
              <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-violeta-600">{area.description}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="mt-14 grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:gap-14">
      <div>
        <h3 class="font-serif text-[1.5rem] font-semibold leading-tight text-violeta">Preguntas que me hacen a menudo</h3>
        <div class="mt-5">
          <FaqList items={homeFaqs} />
        </div>
      </div>
      <nav aria-labelledby="ayuda-mas" class="self-start">
        <p id="ayuda-mas" class="eyebrow">Para conocer más</p>
        <ul class="mt-5 space-y-3">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="text-link inline-flex items-center gap-2 text-[1rem]">
                  {link.label}
                  <ArrowRight size={16} strokeWidth={2} aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</section>
