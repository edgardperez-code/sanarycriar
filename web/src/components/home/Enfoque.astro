---
import { BadgeCheck, HeartHandshake, Sprout } from 'lucide-react';

// Client guide (2026-11): Hilda's approach in three ideas, in her own words.
const ideas = [
  {
    icon: Sprout,
    title: 'Mirar primero hacia adentro',
    text: 'Antes de corregir a tu hijo, te invito a descubrir qué se activa en ti. Muchas veces el cambio empieza por sanar tu propia historia.',
  },
  {
    icon: HeartHandshake,
    title: 'Sin culpa y sin juicios',
    text: 'No existen manuales perfectos. Aquí no vienes a que te califiquen, sino a encontrar herramientas que funcionen para tu familia.',
  },
  {
    icon: BadgeCheck,
    title: 'Herramientas basadas en evidencia',
    text: 'Herramientas prácticas que, aplicadas con amor y empatía, pueden transformar la dinámica de tu hogar.',
  },
];
---

<section id="enfoque" class="bg-nube" aria-labelledby="enfoque-title">
  <div class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 sm:pb-24">
    <p class="eyebrow mb-4">Mi enfoque</p>
    <h2 id="enfoque-title" class="h2 max-w-3xl">Sanar tu historia para criar <em class="title-accent">distinto</em></h2>
    <ul class="mt-10 grid gap-5 md:grid-cols-3">
      {
        ideas.map(({ icon: Icon, title, text }) => (
          <li class="card p-7 sm:p-8">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-lavanda-100 text-lavanda-600">
              <Icon size={24} strokeWidth={1.75} aria-hidden="true" />
            </span>
            <h3 class="h3 mt-5 text-[1.375rem]">{title}</h3>
            <p class="mt-3 text-violeta-600">{text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
