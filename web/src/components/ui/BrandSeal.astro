---
/**
 * The round brand seal ("Sanar y Criar" around the isotipo) on a warm white
 * disc, so its dark lettering reads on any background. Decorative unless an
 * alt text is given. Callers set both width and height (h-* with w-*): some
 * phone browsers do not size an absolutely placed box from aspect-ratio alone,
 * and the image keeps its own shape (object-contain) so it never stretches. Plain files from public/brand (npm run brand-assets), so
 * it also works on pages rendered on demand.
 */
interface Props {
  sizes?: string;
  alt?: string;
  priority?: boolean;
  class?: string;
}

const { sizes = '128px', alt = '', priority = false, class: className = '' } = Astro.props;
---

<span
  class:list={[
    'block aspect-square shrink-0 overflow-hidden rounded-full bg-blanco-calido p-1.5 shadow-[0_10px_30px_-12px_rgb(25_9_51/0.35)] ring-1 ring-borde',
    className,
  ]}
  aria-hidden={alt ? undefined : 'true'}
>
  <img
    src="/brand/sello-256.webp"
    srcset="/brand/sello-128.webp 128w, /brand/sello-256.webp 256w, /brand/sello-384.webp 384w"
    sizes={sizes}
    width="256"
    height="254"
    alt={alt}
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    class="block h-full w-full select-none object-contain"
  />
</span>
