---
import TodoWebBadge from '@/components/ui/TodoWebBadge.astro';
import Wordmark from '@/components/ui/Wordmark.astro';
import NewsletterFooterForm from '@/components/islands/NewsletterFooterForm';
import { site } from '@/site.config';

interface Props {
  /** Newsletter form. Off on the Home page, which has its own «Cartas» band. */
  newsletter?: boolean;
}

const { newsletter = true } = Astro.props;
const year = new Date().getFullYear();

// Client guide (2026-11): a short footer. Pages that left the menu (talleres,
// blog, preguntas frecuentes) are reached from here.
const explore = [
  { href: site.contact.instagramUrl, label: `Instagram ${site.contact.instagramHandle}`, external: true },
  { href: site.platform.loginUrl, label: 'Entrar a mis ebooks' },
  { href: '/preguntas-frecuentes', label: 'Preguntas frecuentes' },
  { href: '/talleres', label: 'Talleres para colegios y empresas' },
  { href: '/blog', label: 'Blog' },
];

const legal = [
  { href: '/terminos', label: 'Términos y condiciones' },
  { href: '/privacidad', label: 'Política de privacidad' },
  { href: '/reembolsos', label: 'Política de reembolsos' },
];
---

<footer class="on-dark border-t border-nube/10 bg-violeta text-nube">
  <div class="mx-auto max-w-6xl px-4 pb-10 pt-16 sm:px-6 sm:pt-20">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr] md:gap-10">
      <div>
        <a href="/" class="inline-block rounded-md" aria-label="Sanar y Criar, inicio">
          <Wordmark tone="light" />
        </a>
        <p class="mt-5 max-w-sm text-[0.9375rem] leading-relaxed text-nube/80">
          {site.professional.name} · Psicóloga infanto-juvenil · {site.professional.license}<br />
          100% online, desde {site.professional.city} para donde estés.
        </p>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-nube/65">
          Los ebooks son recursos de aprendizaje y no sustituyen una evaluación ni una terapia individual.
        </p>
      </div>

      <nav aria-labelledby="footer_explora">
        <p id="footer_explora" class="eyebrow">Explora</p>
        <ul class="mt-5 space-y-2.5">
          {
            explore.map((item) => (
              <li>
                <a
                  href={item.href}
                  {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}
                  class="text-[0.9375rem] text-nube/85 hover:text-nube hover:underline underline-offset-4"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="footer_legal">
        <p id="footer_legal" class="eyebrow">Legal</p>
        <ul class="mt-5 space-y-2.5">
          {
            legal.map((item) => (
              <li>
                <a href={item.href} class="text-[0.9375rem] text-nube/85 hover:text-nube hover:underline underline-offset-4">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    {newsletter && <NewsletterFooterForm client:visible />}

    <div class="mt-14 flex flex-col gap-3 border-t border-nube/15 pt-6 text-sm text-nube/70 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name} · {site.professional.name}, psicóloga ({site.professional.license}).</p>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
        <p>Hecho con cuidado en {site.professional.city}, Venezuela.</p>
        <TodoWebBadge />
      </div>
    </div>
  </div>
</footer>
