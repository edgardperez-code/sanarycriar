---
import { MapPin, MessageCircle, BadgeCheck, MonitorSmartphone } from 'lucide-react';
import Wordmark from '@/components/ui/Wordmark.astro';
import InstagramIcon from '@/components/ui/InstagramIcon.astro';
import NewsletterFooterForm from '@/components/islands/NewsletterFooterForm';
import { site } from '@/site.config';
import { getTestimonials } from '@/lib/content';

const testimonials = getTestimonials();
const year = new Date().getFullYear();

const explore = [
  { href: '/sobre-mi', label: 'Sobre mí' },
  { href: '/agenda', label: 'Consultas' },
  { href: '/cursos', label: 'Cursos y ebooks' },
  { href: '/talleres', label: 'Talleres' },
  { href: '/test-de-crianza', label: 'Test de crianza' },
  ...(testimonials.length > 0 ? [{ href: '/testimonios', label: 'Testimonios' }] : []),
  { href: '/blog', label: 'Blog' },
  { href: '/preguntas-frecuentes', label: 'Preguntas frecuentes' },
  { href: '/links', label: 'Links' },
];

const legal = [
  { href: '/terminos', label: 'Términos y condiciones' },
  { href: '/privacidad', label: 'Política de privacidad' },
  { href: '/reembolsos', label: 'Política de reembolsos' },
];
---

<footer class="on-dark border-t border-nube/10 bg-violeta text-nube">
  <div class="mx-auto max-w-6xl px-4 pb-10 pt-16 sm:px-6 sm:pt-20">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr] md:gap-10">
      <div>
        <a href="/" class="inline-block rounded-md" aria-label="Sanar y Criar, inicio">
          <Wordmark tone="light" />
        </a>
        <p class="mt-5 max-w-sm text-[0.9375rem] leading-relaxed text-nube/80">
          Acompañamiento psicológico cálido y profesional para criar desde la calma, con cursos, ebooks y consultas 100% online.
        </p>
        <ul class="mt-6 space-y-3 text-[0.9375rem] text-nube/85">
          <li>
            <a href={site.contact.whatsappUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-3 hover:text-nube hover:underline underline-offset-4">
              <MessageCircle size={18} strokeWidth={1.75} aria-hidden="true" />
              <span><span class="sr-only">WhatsApp: </span>{site.contact.whatsappNumber}</span>
            </a>
          </li>
          <li>
            <a href={site.contact.instagramUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-3 hover:text-nube hover:underline underline-offset-4">
              <InstagramIcon size={18} />
              <span><span class="sr-only">Instagram: </span>{site.contact.instagramHandle}</span>
            </a>
          </li>
          <li class="flex items-center gap-3">
            <MapPin size={18} strokeWidth={1.75} aria-hidden="true" />
            {site.professional.city}, {site.professional.region}, {site.professional.country}
          </li>
          <li class="flex items-center gap-3">
            <MonitorSmartphone size={18} strokeWidth={1.75} aria-hidden="true" />
            Consultas 100% online
          </li>
          <li class="flex items-center gap-3">
            <BadgeCheck size={18} strokeWidth={1.75} aria-hidden="true" />
            {site.professional.license} · {site.professional.title}
          </li>
        </ul>
      </div>

      <nav aria-labelledby="footer_explora">
        <p id="footer_explora" class="eyebrow">Explora</p>
        <ul class="mt-5 space-y-2.5">
          {
            explore.map((item) => (
              <li>
                <a href={item.href} class="text-[0.9375rem] text-nube/85 hover:text-nube hover:underline underline-offset-4">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <nav aria-labelledby="footer_legal">
          <p id="footer_legal" class="eyebrow">Legal</p>
          <ul class="mt-5 space-y-2.5">
            {
              legal.map((item) => (
                <li>
                  <a href={item.href} class="text-[0.9375rem] text-nube/85 hover:text-nube hover:underline underline-offset-4">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <p class="eyebrow mt-10">Plataforma</p>
        <ul class="mt-5 space-y-2.5">
          <li>
            <a href={site.platform.url} class="text-[0.9375rem] text-nube/85 hover:text-nube hover:underline underline-offset-4">Plataforma de cursos</a>
          </li>
          <li>
            <a href={site.platform.loginUrl} class="text-[0.9375rem] text-nube/85 hover:text-nube hover:underline underline-offset-4">Entrar a mis cursos</a>
          </li>
        </ul>
      </div>
    </div>

    <NewsletterFooterForm client:visible />

    <div class="mt-14 flex flex-col gap-3 border-t border-nube/15 pt-6 text-sm text-nube/70 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name} · {site.professional.name}, psicóloga ({site.professional.license}).</p>
      <p>Hecho con cuidado en {site.professional.city}, Venezuela.</p>
    </div>
  </div>
</footer>
