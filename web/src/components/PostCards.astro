---
import { ArrowRight } from 'lucide-react';
import { formatDate } from '@/lib/content';
import type { BlogCard } from '@/lib/blog';

interface Props {
  posts: BlogCard[];
  headingLevel?: 'h2' | 'h3';
}

const { posts, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---

<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {
    posts.map((post) => (
      <li class="flex">
        <article class="card group relative flex w-full flex-col overflow-hidden hover:border-lavanda-300">
          {post.coverUrl && (
            <img
              src={post.coverUrl}
              alt={post.coverAlt}
              width="640"
              height="360"
              loading="lazy"
              decoding="async"
              class="aspect-[16/9] w-full object-cover"
            />
          )}
          <div class="flex flex-1 flex-col p-6">
            <p class="note flex flex-wrap items-center gap-x-2">
              {post.categoryLabel && <span class="font-semibold text-rosa-600">{post.categoryLabel}</span>}
              {post.categoryLabel && <span aria-hidden="true">·</span>}
              <time datetime={post.publishedAt.toISOString()}>{formatDate(post.publishedAt, 'America/Caracas')}</time>
            </p>
            <H class="mt-2 font-serif text-xl font-semibold leading-snug text-violeta">
              <a href={`/blog/${post.slug}`} class="after:absolute after:inset-0 after:content-['']">
                {post.title}
              </a>
            </H>
            {post.excerpt && <p class="mt-2 line-clamp-3 text-[0.9375rem] leading-relaxed text-violeta-500">{post.excerpt}</p>}
            <span class="mt-auto inline-flex items-center gap-1.5 pt-5 text-[0.9375rem] font-semibold text-lavanda-600 group-hover:text-lavanda-700">
              Leer artículo
              <ArrowRight size={16} strokeWidth={2} />
            </span>
          </div>
        </article>
      </li>
    ))
  }
</ul>
