---
import { ArrowRight } from 'lucide-react';
import { formatDate, type BlogPost } from '@/lib/content';

interface Props {
  posts: BlogPost[];
  headingLevel?: 'h2' | 'h3';
}

const { posts, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---

<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {
    posts.map((post) => (
      <li class="flex">
        <article class="card group relative flex w-full flex-col overflow-hidden hover:border-lavanda-300">
          {post.data.cover && (
            <img
              src={post.data.cover}
              alt={post.data.coverAlt ?? ''}
              width="640"
              height="360"
              loading="lazy"
              decoding="async"
              class="aspect-[16/9] w-full object-cover"
            />
          )}
          <div class="flex flex-1 flex-col p-6">
            <time class="note" datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
            <H class="mt-2 font-serif text-xl font-semibold leading-snug text-violeta">
              <a href={`/blog/${post.id}`} class="after:absolute after:inset-0 after:content-['']">
                {post.data.title}
              </a>
            </H>
            <p class="mt-2 line-clamp-3 text-[0.9375rem] leading-relaxed text-violeta-500">{post.data.description}</p>
            <span class="mt-auto inline-flex items-center gap-1.5 pt-5 text-[0.9375rem] font-semibold text-lavanda-600 group-hover:text-lavanda-700">
              Leer artículo
              <ArrowRight size={16} strokeWidth={2} />
            </span>
          </div>
        </article>
      </li>
    ))
  }
</ul>
