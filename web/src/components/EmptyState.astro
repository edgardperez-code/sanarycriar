---
import { ArrowRight } from 'lucide-react';
import { freeClassHref, site } from '@/site.config';

/** Friendly "coming soon" block for sections without real content yet. */
interface Props {
  title: string;
  text: string;
}

const { title, text } = Astro.props;
---

<div class="card max-w-3xl p-7 sm:p-10">
  <p class="eyebrow">Muy pronto</p>
  <p class="mt-3 font-serif text-2xl font-semibold leading-snug text-violeta sm:text-[1.75rem]">{title}</p>
  <p class="mt-3 max-w-[60ch] text-violeta-600">{text}</p>
  <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
    <a href={freeClassHref} class="btn btn-primary" target="_blank" rel="noopener">
      <span class="sm:hidden">{site.freeClass.mobileLabel}</span>
      <span class="hidden sm:inline">{site.freeClass.label}</span>
      <ArrowRight size={18} strokeWidth={2} aria-hidden="true" />
    </a>
    <a href="/" class="btn btn-secondary">Volver al inicio</a>
  </div>
</div>
