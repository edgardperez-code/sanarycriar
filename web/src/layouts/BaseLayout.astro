---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/playfair-display/600.css';
import '@fontsource/playfair-display/500-italic.css';
import '@fontsource/playfair-display/600-italic.css';
import '@/styles/global.css';
import playfair600 from '@fontsource/playfair-display/files/playfair-display-latin-600-normal.woff2?url';
import poppins400 from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import NewsletterPopup from '@/components/islands/NewsletterPopup';
import { absoluteUrl, site } from '@/site.config';
import { OG_IMAGE, serializeJsonLd } from '@/lib/seo';
import { routePath } from '@/lib/nav';

interface Props {
  /** Page title without the brand suffix. Omit on the Home page. */
  title?: string;
  description?: string;
  /** Social image path or absolute URL (1200×630). */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Emit <link rel="canonical">. Off for the 404 page (its URL is whatever was mistyped). */
  canonical?: boolean;
  jsonLd?: unknown | unknown[];
  /** Minimal chrome (no header/footer), e.g. the Instagram links page. */
  bare?: boolean;
  /**
   * Newsletter pop-up (settings in the platform panel > Boletín). On by
   * default, also on `bare` pages; off on the legal pages and the 404.
   */
  newsletter?: boolean;
}

const {
  title,
  description = site.description,
  image = OG_IMAGE,
  imageAlt = 'Sanar y Criar · Hilda Hernández, psicóloga infanto-juvenil',
  type = 'website',
  noindex = false,
  canonical: withCanonical = true,
  jsonLd,
  bare = false,
  newsletter = true,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} · Hilda Hernández, Psicóloga Infanto-Juvenil`;
const canonical = absoluteUrl(routePath(Astro.url.pathname));
const imageUrl = absoluteUrl(image);
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="es-VE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {withCanonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#FDF5EE" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={playfair600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={poppins400} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    {jsonLdList.map((data) => <script type="application/ld+json" set:html={serializeJsonLd(data)} />)}
    <slot name="head" />
  </head>
  <body class="bg-nube font-sans text-violeta-600 antialiased">
    <a
      href="#contenido_principal"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-violeta focus:px-5 focus:py-3 focus:text-nube"
    >
      Saltar al contenido
    </a>
    {!bare && <Header />}
    <main id="contenido_principal" tabindex="-1" class="outline-none">
      <slot />
    </main>
    {!bare && <Footer />}
    {newsletter && <NewsletterPopup client:load />}
  </body>
</html>
