# Caddy del contenedor del sitio (ver ../Dockerfile). Sirve el build estático por HTTP;
# el HTTPS lo pone la plataforma delante. En el VPS se usa deploy/caddy/Caddyfile.
# /blog, /blog/* y /_server-islands/* los genera Node (Astro bajo demanda) en el mismo
# contenedor (deploy/start.sh); Caddy se los pasa y les pone las mismas cabeceras.
#
# Variables de entorno (en tiempo de ejecución):
#   PORT             puerto de escucha (8080 por defecto)
#   SITE_ORIGIN      origen público del sitio, p. ej. https://www.sanarycriarve.com
#   PLATFORM_ORIGIN  origen de la plataforma de cursos (catálogo, miniaturas y portadas del blog, para la CSP)
#   APEX_HOST        dominio raíz (p. ej. sanarycriarve.com) que redirige a SITE_ORIGIN; opcional
#   SSR_PORT         puerto de Node en 127.0.0.1 (4321 por defecto; lo fija el Dockerfile)
{
	admin off
	auto_https off
	persist_config off
}

(cabeceras_sitio) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: {$PLATFORM_ORIGIN}; font-src 'self'; connect-src 'self' {$PLATFORM_ORIGIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
		-Server
	}
}

:{$PORT:8080} {
	import cabeceras_sitio
	encode zstd gzip
	root * /app/dist/client

	# Root domain -> www, keeping path and query.
	@apex host {$APEX_HOST:apex.invalid}
	redir @apex {$SITE_ORIGIN}{uri} permanent

	# Hashed build assets never change; everything else revalidates (also Node's
	# responses that do not set their own Cache-Control).
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "public, max-age=0, must-revalidate"

	# No trailing slash (/agenda, not /agenda/). Absolute targets: a relative
	# "/\evil.com" would be read by browsers as //evil.com.
	@barra_final path_regexp barra ^(.+)/$
	redir @barra_final {$SITE_ORIGIN}{re.barra.1}{?query} permanent
	redir /ebooks {$SITE_ORIGIN}/cursos{?query} permanent

	# Sanar y Criar: the blog and the server islands are rendered by Node (Astro
	# on demand) on every request, so what is published shows up at once.
	@ssr path /blog /blog/* /_server-islands/*
	handle @ssr {
		reverse_proxy 127.0.0.1:{$SSR_PORT:4321} {
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}

	handle {
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors 404 {
		import cabeceras_sitio
		rewrite * /404.html
		file_server
	}
}
