# Copia este archivo a .env (o define las variables en tu hosting) para cambiar los valores por defecto.
# Todas son públicas: terminan en el HTML/JS del sitio. No pongas secretos aquí.

# Plataforma de cursos (LearnHouse)
PUBLIC_LH_PLATFORM=https://cursos.sanarycriarve.com
PUBLIC_LH_API=https://cursos.sanarycriarve.com/api/v1
PUBLIC_LH_ORG_ID=1

# Dominio canónico del sitio de marketing
PUBLIC_SITE_URL=https://www.sanarycriarve.com

# Enlace de la clase gratuita (si queda vacío, el botón abre WhatsApp con un mensaje)
PUBLIC_FREE_CLASS_URL=

# Enlace para agendar consultas (Cal.com, Google Calendar, etc.). Vacío = WhatsApp
PUBLIC_BOOKING_URL=
