# Variables del sitio de marketing (Astro) para scripts/deploy-sitio.sh.
# Copia a deploy/sitio.env si quieres cambiar algo; sin ese archivo se usan estos valores.
# Todas son PÚBLICAS: terminan en el HTML/JS del sitio. No pongas secretos aquí.

PUBLIC_SITE_URL=https://www.sanarycriarve.com
PUBLIC_LH_PLATFORM=https://cursos.sanarycriarve.com
PUBLIC_LH_API=https://cursos.sanarycriarve.com/api/v1
PUBLIC_LH_ORG_ID=1

# Enlace de la clase gratuita (vacío = el botón abre WhatsApp con un mensaje)
PUBLIC_FREE_CLASS_URL=
# Enlace para agendar consultas (Cal.com, Google Calendar...). Vacío = WhatsApp
PUBLIC_BOOKING_URL=

# Servidor y carpeta de destino (usuario@host por SSH). Vacío = copiar en esta misma máquina.
SC_SSH_DESTINO=
SC_DIR_REMOTO=/opt/sanarycriar
