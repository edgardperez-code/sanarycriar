# =============================================================================
# Sanar y Criar: variables de producción
#
# 1. En el servidor: cp .env.example .env && chmod 600 .env
# 2. Cambia todo lo que diga CAMBIAR. Nunca subas .env a git.
# 3. Formato: CLAVE=valor, sin espacios alrededor de "=". Si el valor tiene
#    espacios o símbolos ($ # ' "), ponlo entre comillas simples: CLAVE='a b'.
# 4. Tras cambiar algo: docker compose -f docker-compose.prod.yml up -d
#    (recrea el contenedor con los valores nuevos).
#
# Para generar secretos aleatorios:  openssl rand -hex 32
# =============================================================================

# -----------------------------------------------------------------------------
# Imagen de la plataforma (la construye GitHub Actions en el repo del fork)
# -----------------------------------------------------------------------------
# ghcr.io/<usuario-u-organización-de-GitHub>/sanarycriar-lms (en minúsculas)
SC_LMS_IMAGE=ghcr.io/edgardperez-code/sanarycriar-lms
# Etiqueta a desplegar: una versión (sc-v1.0.0) o "sanarycriar" (última de la rama).
# Mejor una versión fija: así sabes qué hay en producción y puedes volver atrás.
SC_LMS_TAG=sc-v1.0.0

# -----------------------------------------------------------------------------
# Caddy (HTTPS automático)
# -----------------------------------------------------------------------------
# Correo para avisos de Let's Encrypt (certificados por vencer, etc.)
SC_ACME_EMAIL=CAMBIAR@sanarycriarve.com
# Carpeta del sitio estático (releases/ + enlace current). No cambiar.
SC_WWW_DIR=./www
# Opciones globales extra de Caddy. Vacío en producción.
SC_CADDY_GLOBAL=

# -----------------------------------------------------------------------------
# Base de datos (Postgres)
# -----------------------------------------------------------------------------
# Solo letras y números (va dentro de una URL):  openssl rand -hex 24
POSTGRES_PASSWORD=CAMBIAR

# -----------------------------------------------------------------------------
# LearnHouse: modo y dominio
# -----------------------------------------------------------------------------
LEARNHOUSE_DEVELOPMENT_MODE=false
LEARNHOUSE_DISABLE_EE=1
# Una sola organización en cursos.sanarycriarve.com. Sin LEARNHOUSE_COOKIE_DOMAIN:
# en modo single las cookies son del host exacto (se ignora y avisa si se define).
LEARNHOUSE_TENANCY=single
LEARNHOUSE_DOMAIN=cursos.sanarycriarve.com
LEARNHOUSE_FRONTEND_DOMAIN=cursos.sanarycriarve.com
# true = los enlaces de los correos usan https://
LEARNHOUSE_SSL=true
# Host público que sirve /content (logos en correos, miniaturas del catálogo) y
# base de la URL del webhook de PayPal que muestra el panel. Sin esto se inventaría
# https://api.cursos.sanarycriarve.com, que no existe.
LEARNHOUSE_MEDIA_URL=https://cursos.sanarycriarve.com
# Orígenes aceptados por la protección CSRF de la API.
LEARNHOUSE_ALLOWED_ORIGINS=https://cursos.sanarycriarve.com
LEARNHOUSE_ALLOWED_REGEXP='^https://cursos\.sanarycriarve\.com$'
# El sitio de marketing lee el catálogo público desde el navegador (solo lectura, sin cookies).
LEARNHOUSE_EXTRA_CORS_ORIGINS=https://www.sanarycriarve.com,https://sanarycriarve.com
LEARNHOUSE_SITE_NAME='Sanar y Criar'
LEARNHOUSE_SITE_DESCRIPTION='Cursos y ebooks de crianza consciente con Hilda Hernández, psicóloga clínica infanto-juvenil.'
# Correo de contacto que muestra la plataforma
LEARNHOUSE_CONTACT_EMAIL=CAMBIAR@sanarycriarve.com
# Caddy está delante y pasa la IP real (X-Forwarded-For); el rate limit la usa.
LEARNHOUSE_SECURITY__TRUST_PROXY_HEADERS=true
COLLAB_TRUST_PROXY=true

# -----------------------------------------------------------------------------
# Secretos (genera cada uno con: openssl rand -hex 32)
# Si cambias LEARNHOUSE_AUTH_JWT_SECRET_KEY se cierran todas las sesiones y hay que
# volver a pegar el Secret de PayPal en Pagos > Configuración (se guarda cifrado con
# una clave derivada de este secreto). Si este secreto se filtra, rota también el
# Secret de la app en PayPal.
# Si cambias LEARNHOUSE_MFA_ENCRYPTION_KEY dejan de funcionar los 2FA ya activados.
# -----------------------------------------------------------------------------
LEARNHOUSE_AUTH_JWT_SECRET_KEY=CAMBIAR
LEARNHOUSE_MFA_ENCRYPTION_KEY=CAMBIAR
COLLAB_INTERNAL_KEY=CAMBIAR

# -----------------------------------------------------------------------------
# Organización y administradora iniciales (solo se usan en el PRIMER arranque,
# cuando la base de datos está vacía). Después de entrar por primera vez y
# cambiar la contraseña desde el panel, puedes borrar la contraseña de aquí.
# -----------------------------------------------------------------------------
LEARNHOUSE_INITIAL_ORG_NAME='Sanar y Criar'
LEARNHOUSE_INITIAL_ORG_SLUG=sanarycriar
LEARNHOUSE_INITIAL_ADMIN_EMAIL=CAMBIAR@sanarycriarve.com
# Contraseña larga (16 caracteres o más): openssl rand -base64 18
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=CAMBIAR

# -----------------------------------------------------------------------------
# Correo saliente (bienvenida, enlaces mágicos, recuperar contraseña, compras)
# El remitente debe ser del dominio verificado (SPF/DKIM): ver docs/despliegue.md
# -----------------------------------------------------------------------------
LEARNHOUSE_SYSTEM_EMAIL_ADDRESS=no-responder@sanarycriarve.com
LEARNHOUSE_SYSTEM_EMAIL_SENDER_NAME='Sanar y Criar'

# Opción A (recomendada): Resend, con su API key (resend.com > API Keys, permiso "Sending access")
LEARNHOUSE_EMAIL_PROVIDER=resend
LEARNHOUSE_RESEND_API_KEY=re_CAMBIAR

# Opción B: cualquier SMTP (Resend, Brevo, Zoho, Google Workspace...).
# Comenta las dos líneas de la opción A y descomenta estas.
# Puerto 465 = TLS implícito; 587 = STARTTLS. Con usuario, el TLS es obligatorio.
#LEARNHOUSE_EMAIL_PROVIDER=smtp
#LEARNHOUSE_SMTP_HOST=smtp.resend.com
#LEARNHOUSE_SMTP_PORT=465
#LEARNHOUSE_SMTP_USERNAME=resend
#LEARNHOUSE_SMTP_PASSWORD=CAMBIAR
#LEARNHOUSE_SMTP_USE_TLS=true

# -----------------------------------------------------------------------------
# Archivos y video
# -----------------------------------------------------------------------------
# filesystem = en el volumen "content" del VPS (incluido en scripts/backup.sh)
LEARNHOUSE_CONTENT_DELIVERY_TYPE=filesystem
# HLS: convierte cada video subido a streaming adaptable (ffmpeg dentro del contenedor).
# Mientras se convierte, el curso usa el MP4 original. Una conversión a la vez.
LEARNHOUSE_HLS_ENABLED=true
LEARNHOUSE_HLS_INPROCESS_WORKER=true
LEARNHOUSE_HLS_CONCURRENCY=1
# Hilos de ffmpeg por conversión (2 en un VPS de 2-3 vCPU deja aire a la web)
LEARNHOUSE_HLS_FFMPEG_THREADS=2
# Cifrado AES-128 de los segmentos (dificulta descargar el video completo)
LEARNHOUSE_HLS_ENCRYPT=true

# -----------------------------------------------------------------------------
# Otras funciones
# -----------------------------------------------------------------------------
LEARNHOUSE_IS_AI_ENABLED=false
# Conciliación automática de pagos PayPal cada 5 min (1 = activada)
LEARNHOUSE_PAYMENTS_RECONCILE=1
# NO definir LEARNHOUSE_PAYPAL_API_BASE ni LEARNHOUSE_PAYPAL_WEB_BASE: son solo para
# el simulador local (y en producción se ignoran). PayPal se configura en el panel:
# Pagos > Configuración.

# Inicio de sesión con Google (opcional). Callback: https://cursos.sanarycriarve.com/auth/callback/google
#LEARNHOUSE_GOOGLE_CLIENT_ID=
#LEARNHOUSE_GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Web (Next.js). Se leen al arrancar el contenedor (no hace falta reconstruir la imagen).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_LEARNHOUSE_API_URL=https://cursos.sanarycriarve.com/api/v1/
NEXT_PUBLIC_LEARNHOUSE_BACKEND_URL=https://cursos.sanarycriarve.com/
NEXT_PUBLIC_LEARNHOUSE_MEDIA_URL=https://cursos.sanarycriarve.com/
NEXT_PUBLIC_LEARNHOUSE_DOMAIN=cursos.sanarycriarve.com
NEXT_PUBLIC_LEARNHOUSE_TOP_DOMAIN=cursos.sanarycriarve.com
NEXT_PUBLIC_LEARNHOUSE_DEFAULT_ORG=sanarycriar
NEXT_PUBLIC_LEARNHOUSE_MULTI_ORG=false
# En minúsculas: la web compara exactamente con 'true'
NEXT_PUBLIC_LEARNHOUSE_HTTPS=true
NEXT_PUBLIC_COLLAB_URL=wss://cursos.sanarycriarve.com/collab
# Sitio de marketing (enlaces "Volver al sitio" de la plataforma)
NEXT_PUBLIC_SC_SITE_URL=https://www.sanarycriarve.com
# Código fuente público del fork (enlace "Código fuente" del pie; obligación AGPL-3.0 §13)
NEXT_PUBLIC_SC_SOURCE_URL=https://github.com/edgardperez-code/sanarycriar-learnhouse/tree/sanarycriar

# -----------------------------------------------------------------------------
# Copias de seguridad (scripts/backup.sh)
# -----------------------------------------------------------------------------
# Carpeta donde se guardan (relativa a esta carpeta o absoluta)
SC_BACKUP_DIR=./backups
# Días que se conservan
SC_BACKUP_KEEP_DAYS=14
# Copia fuera del servidor con rclone (opcional), p. ej. "b2:sanarycriar-respaldos".
# Requiere rclone instalado y configurado (rclone config). Usa una carpeta solo para
# esto: allí también se borran las copias más viejas que SC_BACKUP_KEEP_DAYS.
# Solo se suben la base de datos y los archivos (nunca este .env) y siempre cifrados:
# o defines SC_BACKUP_AGE_RECIPIENT, o el remoto es de tipo "crypt" de rclone.
SC_BACKUP_RCLONE_REMOTE=
# Clave pública de age (age1...) con la que se cifran las copias que se suben.
# Genera el par en TU computadora (age-keygen -o respaldo.key) y guarda la clave
# privada en tu gestor de contraseñas, no en el servidor. Requiere: sudo apt install age
SC_BACKUP_AGE_RECIPIENT=
